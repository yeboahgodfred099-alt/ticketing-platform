# ==============================================================================
# SECURE MOBILE MONEY TICKETING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME="ClevaWave Ticketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_LOCALE=en

# PostgreSQL (Authoritative Store)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ticketing
DB_USERNAME=ticketing_app
DB_PASSWORD=secret_ticketing_password
DB_MIGRATION_USERNAME=ticketing_migrations
DB_MIGRATION_PASSWORD=secret_migration_password

# Redis (Queues, Cache, Short-lived locks)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Paystack Payment Gateway (Ghana Mobile Money)
# WARNING: PAYSTACK_SECRET_KEY must NEVER be exposed in frontend or client bundles
PAYSTACK_PUBLIC_KEY=pk_test_sample_key
PAYSTACK_SECRET_KEY=sk_test_sample_key
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# Session & Authentication (Sanctum)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_SECURE_COOKIE=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="tickets@clevawave.com"
MAIL_FROM_NAME="ClevaWave Ticketing"

# Queues & Background Processing
QUEUE_CONNECTION=redis

# File Storage (local for dev, s3 for production)
FILESYSTEM_DISK=local

# Monitoring & Error Reporting
SENTRY_LARAVEL_DSN=
SENTRY_NEXTJS_DSN=
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Business Logic Configuration
RESERVATION_TTL_MINUTES=15
PAYMENT_TIMEOUT_SECONDS=180
RECONCILIATION_INTERVAL_MINUTES=5
RECONCILIATION_PENDING_THRESHOLD_MINUTES=10

